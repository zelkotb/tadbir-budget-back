<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.8</version>
        <relativePath/>
    </parent>

    <groupId>ma.zakaria</groupId>
    <artifactId>tadbir-budget</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>tadbir-budget</name>
    <description>tadbir-budget — parent aggregator</description>

    <modules>
        <module>tadbir-budget-common</module>
        <module>tadbir-budget-dao</module>
        <module>tadbir-budget-auth-jwt</module>
        <module>tadbir-budget-user</module>
        <module>tadbir-budget-org</module>
        <module>tadbir-budget-nomenclature</module>
        <module>tadbir-budget-notification</module>
        <module>tadbir-budget-workflow</module>
        <module>tadbir-budget-files</module>
        <module>tadbir-budget-app</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <!-- versions not managed by the Spring Boot BOM -->
        <jjwt.version>0.12.6</jjwt.version>
        <liquibase.version>4.33.0</liquibase.version>
        <modelmapper.version>3.2.4</modelmapper.version>
        <poi.version>5.3.0</poi.version>
        <apacheds.version>1.5.5</apacheds.version>
        <license-plugin.version>4.6</license-plugin.version>
        <bucket4j.version>8.10.1</bucket4j.version>
        <shedlock.version>5.16.0</shedlock.version>
        <flowable.version>7.1.0</flowable.version>
        <flyingsaucer.version>9.4.0</flyingsaucer.version>
        <jasperreports.version>6.21.3</jasperreports.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>ma.zakaria</groupId>
                <artifactId>tadbir-budget-common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.zakaria</groupId>
                <artifactId>tadbir-budget-dao</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.zakaria</groupId>
                <artifactId>tadbir-budget-auth-jwt</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.zakaria</groupId>
                <artifactId>tadbir-budget-user</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.zakaria</groupId>
                <artifactId>tadbir-budget-org</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.zakaria</groupId>
                <artifactId>tadbir-budget-nomenclature</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.zakaria</groupId>
                <artifactId>tadbir-budget-notification</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.zakaria</groupId>
                <artifactId>tadbir-budget-workflow</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ma.zakaria</groupId>
                <artifactId>tadbir-budget-files</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- JWT (jjwt) -->
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-api</artifactId>
                <version>${jjwt.version}</version>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-impl</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>
            <dependency>
                <groupId>io.jsonwebtoken</groupId>
                <artifactId>jjwt-jackson</artifactId>
                <version>${jjwt.version}</version>
                <scope>runtime</scope>
            </dependency>

            <!-- Database migrations -->
            <dependency>
                <groupId>org.liquibase</groupId>
                <artifactId>liquibase-core</artifactId>
                <version>${liquibase.version}</version>
            </dependency>

            <!-- Object mapping -->
            <dependency>
                <groupId>org.modelmapper</groupId>
                <artifactId>modelmapper</artifactId>
                <version>${modelmapper.version}</version>
            </dependency>

            <!-- Excel processing -->
            <dependency>
                <groupId>org.apache.poi</groupId>
                <artifactId>poi-ooxml</artifactId>
                <version>${poi.version}</version>
            </dependency>

            <!-- Rate limiting -->
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>

            <!-- Distributed scheduler lock (multi-instance safety) -->
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-spring</artifactId>
                <version>${shedlock.version}</version>
            </dependency>
            <dependency>
                <groupId>net.javacrumbs.shedlock</groupId>
                <artifactId>shedlock-provider-jdbc-template</artifactId>
                <version>${shedlock.version}</version>
            </dependency>

            <!-- Workflow / BPMN engine (open source) -->
            <dependency>
                <groupId>org.flowable</groupId>
                <artifactId>flowable-spring-boot-starter-process</artifactId>
                <version>${flowable.version}</version>
            </dependency>

            <!-- HTML/CSS -> PDF (Flying Saucer, pulls OpenPDF). Used for the requête PDF. -->
            <dependency>
                <groupId>org.xhtmlrenderer</groupId>
                <artifactId>flying-saucer-pdf-openpdf</artifactId>
                <version>${flyingsaucer.version}</version>
            </dependency>

            <!-- JasperReports: designed/pixel-perfect reports (.jrxml) -> PDF. Used by
                 JasperReportService. The 6.21.x line bundles the PDF exporter (no separate
                 artifact) and the SAX .jrxml compiler. -->
            <dependency>
                <groupId>net.sf.jasperreports</groupId>
                <artifactId>jasperreports</artifactId>
                <version>${jasperreports.version}</version>
            </dependency>

            <!-- Test: embedded LDAP -->
            <dependency>
                <groupId>org.apache.directory.server</groupId>
                <artifactId>apacheds-server-jndi</artifactId>
                <version>${apacheds.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <release>17</release>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>

                <!-- License / Copyright header — configured here, activated per child module -->
                <plugin>
                    <groupId>com.mycila</groupId>
                    <artifactId>license-maven-plugin</artifactId>
                    <version>${license-plugin.version}</version>
                    <configuration>
                        <licenseSets>
                            <licenseSet>
                                <!-- resolved relative to each child module's basedir -->
                                <header>../src/license/header.txt</header>
                                <includes>
                                    <include>src/main/java/**/*.java</include>
                                    <include>src/test/java/**/*.java</include>
                                </includes>
                                <excludes>
                                    <exclude>**/package-info.java</exclude>
                                </excludes>
                            </licenseSet>
                        </licenseSets>
                        <properties>
                            <year>2026</year>
                        </properties>
                        <strictCheck>true</strictCheck>
                        <skipExistingHeaders>false</skipExistingHeaders>
                    </configuration>
                    <executions>
                        <execution>
                            <id>check-license-headers</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-deploy-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>security</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.owasp</groupId>
                        <artifactId>dependency-check-maven</artifactId>
                        <version>11.1.0</version>
                        <configuration>
                            <!-- Fail on CVSS >= 7 (HIGH severity) -->
                            <failBuildOnCVSS>7</failBuildOnCVSS>
                            <!-- Skip .NET assembly analysis (not applicable) -->
                            <assemblyAnalyzerEnabled>false</assemblyAnalyzerEnabled>
                        </configuration>
                        <executions>
                            <execution>
                                <goals>
                                    <goal>check</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

</project>