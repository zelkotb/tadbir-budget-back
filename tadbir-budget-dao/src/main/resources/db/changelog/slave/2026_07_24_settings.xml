<!--
    Company-wide settings (paramétrage): a simple key/value store. Seeds the project.terminology
    setting (PROJECT | PROGRAM) that decides how the UI labels projects vs programs.
-->
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.25.xsd">

    <changeSet id="create_app_setting" author="zakaria el kotb">
        <sql>
            create table app_setting (
                setting_key varchar(100) not null,
                setting_value varchar(500),
                updated_by varchar(255),
                updated_at timestamp(6) with time zone,
                primary key (setting_key)
            );
        </sql>
        <insert tableName="app_setting">
            <column name="setting_key" value="project.terminology"/>
            <column name="setting_value" value="PROJECT"/>
        </insert>
        <rollback>
            <sql>drop table if exists app_setting cascade;</sql>
        </rollback>
    </changeSet>

</databaseChangeLog>
